<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:orientation="horizontal" android:padding="12dp" android:layout_marginBottom="8dp" android:background="@drawable/bg_surface_card">
    <ImageView android:id="@+id/comment_avatar" android:layout_width="36dp" android:layout_height="36dp"
        android:background="@drawable/bg_comment_avatar" android:clipToOutline="true" android:scaleType="centerCrop"
        android:contentDescription="评论用户头像"/>
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:layout_marginStart="11dp" android:orientation="vertical">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <TextView android:id="@+id/comment_user" android:layout_width="0dp" android:layout_height="wrap_content"
                android:layout_weight="1" android:textColor="@color/text_secondary" android:textSize="12sp" android:textStyle="bold"/>
            <TextView android:id="@+id/comment_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:textColor="@color/text_secondary" android:textSize="10sp"/>
        </LinearLayout>
        <TextView android:id="@+id/comment_text" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="7dp" android:textColor="@color/text_primary" android:textSize="14sp" android:lineSpacingExtra="2dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:gravity="center_vertical">
            <TextView android:id="@+id/comment_likes" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:background="@drawable/bg_pill_soft" android:textColor="@color/text_secondary" android:textSize="11sp"/>
            <TextView android:id="@+id/comment_replies" android:layout_width="wrap_content" android:layout_height="wrap_content"
                android:paddingHorizontal="9dp" android:paddingVertical="5dp" android:layout_marginStart="6dp" android:background="@drawable/bg_empty_card" android:textColor="@color/text_secondary" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</LinearLayout>