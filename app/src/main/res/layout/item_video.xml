<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="12dp" app:cardBackgroundColor="@color/surface_dark"
    app:cardCornerRadius="14dp" app:strokeColor="@color/stroke_dark" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:padding="10dp">
        <ImageView android:id="@+id/video_cover" android:layout_width="132dp"
            android:layout_height="86dp" android:background="@drawable/bg_empty_card"
            android:contentDescription="视频封面" android:scaleType="centerCrop"/>
        <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_marginStart="12dp" android:layout_weight="1" android:orientation="vertical">
            <TextView android:id="@+id/video_title" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:maxLines="2"
                android:ellipsize="end" android:textColor="@color/text_primary"
                android:textSize="14sp" android:textStyle="bold"/>
            <TextView android:id="@+id/video_author" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="7dp"
                android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="12sp"/>
            <TextView android:id="@+id/video_meta" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:layout_marginTop="4dp"
                android:maxLines="1" android:textColor="@color/text_secondary" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>