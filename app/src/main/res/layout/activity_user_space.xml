<?xml version="1.0" encoding="utf-8"?>
<ScrollView android:id="@+id/space_scroll" xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="12dp" android:paddingBottom="18dp">
  <LinearLayout android:layout_width="match_parent" android:layout_height="48dp" android:gravity="center_vertical" android:orientation="horizontal">
   <ImageButton android:id="@+id/space_back" android:layout_width="38dp" android:layout_height="38dp" android:background="?attr/selectableItemBackgroundBorderless" android:src="@drawable/ic_back" android:tint="@color/text_primary" android:contentDescription="返回"/>
   <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="8dp" android:id="@+id/space_page_title" android:text="个人空间" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/>
  </LinearLayout>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" app:cardBackgroundColor="@color/surface_dark" app:cardCornerRadius="16dp" app:cardElevation="0dp" app:strokeColor="@color/stroke_dark" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
     <ImageView android:id="@+id/space_avatar" android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/bg_comment_avatar" android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="用户头像"/>
     <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
      <TextView android:id="@+id/space_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="正在加载…" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/>
      <TextView android:id="@+id/space_uid" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="5dp" android:textColor="@color/text_secondary" android:textSize="12sp"/>
     </LinearLayout>
    </LinearLayout>
    <View android:layout_width="match_parent" android:layout_height="1dp" android:layout_marginTop="14dp" android:layout_marginBottom="12dp" android:background="@color/divider"/>
    <TextView android:id="@+id/space_sign" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/text_secondary" android:textSize="13sp" android:lineSpacingExtra="2dp"/>
    <TextView android:id="@+id/space_stats" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:textColor="@color/brand_dark" android:textSize="13sp" android:textStyle="bold"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/space_follow_button"
        android:layout_width="match_parent" android:layout_height="40dp" android:layout_marginTop="12dp"
        android:text="关注 UP主" android:textSize="12sp" android:textColor="@color/white"
        style="@style/Widget.Material3.Button.TextButton" app:backgroundTint="@color/brand"
        app:cornerRadius="10dp"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <LinearLayout android:id="@+id/space_own_shortcuts" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="vertical" android:visibility="gone">
   <TextView android:id="@+id/space_own_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:paddingStart="2dp" android:paddingBottom="8dp" android:text="我的内容" android:textColor="@color/text_primary" android:textSize="16sp" android:textStyle="bold"/>
   <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:columnCount="3" android:rowCount="3">
    <TextView android:id="@+id/space_own_favorites" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="☆&#10;我的收藏" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/space_own_following" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="◎&#10;我的关注" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/space_own_bangumi" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="▣&#10;我的追番" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/space_own_cinema" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="▣&#10;我的追剧" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/space_own_history" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="◷&#10;历史记录" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/space_own_watch_later" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="▤&#10;稍后再看" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/space_own_liked" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="♡&#10;我赞过的" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
    <TextView android:id="@+id/space_own_messages" android:layout_width="0dp" android:layout_height="58dp" android:layout_columnWeight="1" android:gravity="center" android:text="✉&#10;消息中心" android:textColor="@color/text_primary" android:textSize="13sp" android:background="?attr/selectableItemBackground"/>
   </GridLayout>
  </LinearLayout>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" android:paddingStart="2dp" android:id="@+id/space_video_heading" android:text="TA 的投稿" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold"/>
  <TextView android:id="@+id/space_video_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="正在加载投稿…" android:textColor="@color/text_secondary" android:textSize="12sp"/>
  <androidx.recyclerview.widget.RecyclerView android:id="@+id/space_videos" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:nestedScrollingEnabled="false" android:clipToPadding="false" android:paddingBottom="12dp"/>
  <TextView android:id="@+id/space_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:gravity="center" android:text="正在获取用户资料…" android:textColor="@color/text_secondary" android:textSize="12sp"/>
 </LinearLayout>
</ScrollView>