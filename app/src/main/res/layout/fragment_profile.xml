<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:fillViewport="true" android:overScrollMode="never">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingStart="14dp" android:paddingEnd="14dp" android:paddingTop="14dp" android:paddingBottom="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="46dp" android:gravity="center_vertical" android:text="我的" android:textColor="@color/text_primary" android:textSize="22sp" android:textStyle="bold" android:includeFontPadding="false"/>
        <com.google.android.material.card.MaterialCardView android:id="@+id/account_header_card" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:clickable="true" android:focusable="true" android:foreground="?attr/selectableItemBackground" app:cardBackgroundColor="@color/surface_dark" app:cardCornerRadius="18dp" app:cardElevation="0dp" app:strokeColor="@color/divider" app:strokeWidth="0dp">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal" android:padding="18dp">
                <ImageView android:id="@+id/account_avatar" android:layout_width="62dp" android:layout_height="62dp" android:background="@drawable/bg_comment_avatar" android:clipToOutline="true" android:scaleType="centerCrop" android:contentDescription="我的头像"/>
                <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginStart="14dp" android:layout_weight="1" android:orientation="vertical">
                    <TextView android:id="@+id/account_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="未登录" android:textColor="@color/text_primary" android:textSize="18sp" android:textStyle="bold" android:includeFontPadding="false"/>
                    <TextView android:id="@+id/account_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="7dp" android:text="浏览、搜索和游客播放无需登录" android:textColor="@color/text_secondary" android:textSize="12sp"/>
                </LinearLayout>
            </LinearLayout>
        </com.google.android.material.card.MaterialCardView>
        <com.google.android.material.button.MaterialButton android:id="@+id/account_qr_login" style="@style/Widget.Material3.Button.TextButton" android:layout_width="match_parent" android:layout_height="44dp" android:layout_marginTop="12dp" android:minHeight="44dp" android:text="B站 APP 扫码登录" android:textColor="@color/white" android:textSize="13sp" app:backgroundTint="@color/brand" app:cornerRadius="12dp"/>
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="6dp" android:orientation="horizontal">
            <com.google.android.material.button.MaterialButton android:id="@+id/account_refresh" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_weight="1" android:text="刷新账号" android:textColor="@color/text_primary" android:textSize="12sp" app:backgroundTint="@color/surface_elevated" app:cornerRadius="10dp"/>
            <com.google.android.material.button.MaterialButton android:id="@+id/account_logout" style="@style/Widget.Material3.Button.TextButton" android:layout_width="0dp" android:layout_height="40dp" android:layout_marginStart="8dp" android:layout_weight="1" android:text="退出登录" android:textColor="@color/text_secondary" android:textSize="12sp" app:backgroundTint="@color/surface_elevated" app:cornerRadius="10dp"/>
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="我的内容" android:textColor="@color/text_primary" android:textSize="17sp" android:textStyle="bold"/>
        <GridLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="10dp" android:columnCount="3" android:rowCount="3" android:useDefaultMargins="false">
            <TextView android:id="@+id/account_history" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_history" android:text="历史记录"/>
            <TextView android:id="@+id/account_watch_later" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_watch_later" android:text="稍后再看"/>
            <TextView android:id="@+id/account_favorites" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_favorite" android:text="我的收藏"/>
            <TextView android:id="@+id/account_following" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_following" android:text="我的关注"/>
            <TextView android:id="@+id/account_liked" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_liked" android:text="我赞过的"/>
            <TextView android:id="@+id/account_messages" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_messages" android:text="消息概览"/>
            <TextView android:id="@+id/account_bangumi" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_bangumi" android:text="我的追番"/>
            <TextView android:id="@+id/account_cinema" style="@style/AccountMenuTile" android:drawableTop="@drawable/ic_menu_cinema" android:text="我的追剧"/>
        </GridLayout>
    </LinearLayout>
</ScrollView>