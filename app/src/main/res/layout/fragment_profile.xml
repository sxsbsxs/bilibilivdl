<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_dark" android:fillViewport="true">
 <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="22dp">
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="我的" android:textColor="@color/text_primary" android:textSize="26sp" android:textStyle="bold"/>
  <com.google.android.material.card.MaterialCardView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="20dp" app:cardBackgroundColor="@color/surface_elevated" app:cardCornerRadius="20dp" app:strokeColor="@color/stroke_dark" app:strokeWidth="1dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="20dp">
    <TextView android:id="@+id/account_name" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="未登录" android:textColor="@color/text_primary" android:textSize="21sp" android:textStyle="bold"/>
    <TextView android:id="@+id/account_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="正在检查账号状态…" android:textColor="@color/text_secondary" android:textSize="13sp"/>
   </LinearLayout>
  </com.google.android.material.card.MaterialCardView>
  <com.google.android.material.button.MaterialButton android:id="@+id/account_qr_login" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="18dp" android:text="使用哔哩哔哩 APP 扫码登录" android:textAllCaps="false" app:backgroundTint="@color/brand" app:cornerRadius="16dp"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/account_refresh" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="刷新账号状态" android:textAllCaps="false" style="@style/Widget.Material3.Button.OutlinedButton"/>
  <com.google.android.material.button.MaterialButton android:id="@+id/account_logout" android:layout_width="match_parent" android:layout_height="48dp" android:layout_marginTop="8dp" android:text="退出登录" android:textAllCaps="false" style="@style/Widget.Material3.Button.TextButton"/>
  <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="24dp" android:text="登录后可使用账号拥有的清晰度和互动功能。视频浏览与游客可用的播放功能不要求登录。" android:textColor="@color/text_secondary" android:textSize="12sp"/>
 </LinearLayout>
</ScrollView>