<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:background="@color/background_dark" android:orientation="vertical"
    android:paddingStart="16dp" android:paddingEnd="16dp" android:paddingTop="18dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="发现视频" android:textColor="@color/text_primary"
        android:textSize="26sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="5dp" android:text="搜索视频、UP 主，或直接输入 BV / AV 号"
        android:textColor="@color/text_secondary" android:textSize="13sp"/>
    <com.google.android.material.textfield.TextInputLayout
        android:id="@+id/search_input_layout" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="18dp"
        android:hint="输入关键词、BV 号或 AV 号"
        app:boxBackgroundColor="@color/surface_elevated" app:boxBackgroundMode="filled"
        app:boxCornerRadiusTopStart="14dp" app:boxCornerRadiusTopEnd="14dp"
        app:boxCornerRadiusBottomStart="14dp" app:boxCornerRadiusBottomEnd="14dp"
        app:hintTextColor="@color/text_secondary">
        <com.google.android.material.textfield.TextInputEditText
            android:id="@+id/search_input" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:imeOptions="actionSearch"
            android:inputType="text" android:maxLines="1"
            android:textColor="@color/text_primary" android:textColorHint="@color/text_secondary"/>
    </com.google.android.material.textfield.TextInputLayout>
    <com.google.android.material.button.MaterialButton
        android:id="@+id/search_button" android:layout_width="match_parent"
        android:layout_height="48dp" android:layout_marginTop="10dp"
        android:text="搜索" android:textAllCaps="false"
        android:textColor="@color/white" app:backgroundTint="@color/brand"
        app:cornerRadius="14dp"/>
    <ProgressBar android:id="@+id/search_progress" style="?android:attr/progressBarStyle"
        android:layout_width="32dp" android:layout_height="32dp"
        android:layout_gravity="center_horizontal" android:layout_marginTop="12dp"
        android:indeterminateTint="@color/brand" android:visibility="gone"/>
    <TextView android:id="@+id/search_status" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="输入关键词开始搜索" android:textColor="@color/text_secondary"
        android:textSize="13sp"/>
    <androidx.recyclerview.widget.RecyclerView android:id="@+id/search_results"
        android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_marginTop="8dp" android:layout_weight="1"
        android:clipToPadding="false" android:paddingBottom="12dp"/>
</LinearLayout>
