<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto"
 android:id="@+id/home_swipe" android:layout_width="match_parent" android:layout_height="match_parent" android:background="@color/background_light">
 <androidx.core.widget.NestedScrollView android:id="@+id/home_scroll" android:layout_width="match_parent" android:layout_height="match_parent" android:fillViewport="true">
  <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="12dp">
   <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
    <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="BiliVdl" android:textColor="@color/text_primary" android:textSize="27sp" android:textStyle="bold"/>
    <com.google.android.material.button.MaterialButton android:id="@+id/home_login_button" android:layout_width="wrap_content" android:layout_height="40dp" android:layout_marginEnd="8dp" android:minWidth="0dp" android:text="登录" android:textAllCaps="false" app:cornerRadius="20dp"/>
    <ImageButton android:id="@+id/home_search_button" android:layout_width="44dp" android:layout_height="44dp" android:background="@drawable/bg_search_button" android:contentDescription="搜索视频" android:padding="11dp" android:src="@drawable/ic_search" android:tint="@color/text_primary"/>
   </LinearLayout>
   <com.google.android.material.card.MaterialCardView android:id="@+id/home_search_entry" android:layout_width="match_parent" android:layout_height="52dp" android:layout_marginTop="16dp" android:clickable="true" android:focusable="true" app:cardBackgroundColor="@color/surface_elevated" app:cardCornerRadius="14dp" app:strokeColor="@color/stroke_dark" app:strokeWidth="1dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center_vertical" android:paddingHorizontal="15dp">
     <ImageView android:layout_width="20dp" android:layout_height="20dp" android:src="@drawable/ic_search" android:tint="@color/text_secondary"/>
     <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginStart="10dp" android:text="搜索视频 / BV号 / AV号" android:textColor="@color/text_secondary" android:textSize="14sp"/>
    </LinearLayout>
   </com.google.android.material.card.MaterialCardView>
   <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp" android:text="为你推荐" android:textColor="@color/text_primary" android:textSize="19sp" android:textStyle="bold"/>
   <ProgressBar android:id="@+id/home_progress" android:layout_width="28dp" android:layout_height="28dp" android:layout_gravity="center_horizontal" android:layout_marginTop="16dp" android:indeterminateTint="@color/brand" android:visibility="gone"/>
   <TextView android:id="@+id/home_feed_status" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="正在加载推荐视频…" android:textColor="@color/text_secondary" android:textSize="12sp"/>
   <androidx.recyclerview.widget.RecyclerView android:id="@+id/home_recommendations" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="12dp" android:clipToPadding="false" android:nestedScrollingEnabled="false" android:paddingBottom="12dp"/>
  </LinearLayout>
 </androidx.core.widget.NestedScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
